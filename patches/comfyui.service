[Unit]
Description=ComfyUI (Z-Image / H3, patched build)
After=network.target ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/m/ComfyUI
Environment=HOME=/root
ExecStartPre=/bin/mount -o remount,exec /opt/m
ExecStart=/bin/bash -c 'source /opt/m/comfyui-env.sh >/dev/null 2>&1; exec /opt/m/ComfyUI/venv/bin/python main.py --listen 0.0.0.0 --port 8188 --enable-dynamic-vram --vram-headroom 1 --cache-lru 1 --disable-pinned-memory'
Restart=always
RestartSec=10
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target

+    # H3 patch: coerce float attn_mask to query dtype (SDPA rejects fp32 mask vs bf16 q)
+    if attn_mask is not None and attn_mask.dtype != torch.bool and attn_mask.dtype != q.dtype and attn_mask.dtype.is_floating_point:
+        kwargs = dict(kwargs)
+        kwargs["attn_mask"] = attn_mask.to(q.dtype)
+        if len(args) > 0:
+            args = ()
+    # H3 patch: chunked attention when the score tensor would blow memory
+    Sq = q.shape[-2]
+    Sk = k.shape[-2]
+    est = Sq * Sk * q.shape[0] * q.shape[1] * q.element_size()
+    if est > 3e8:
+        return _h3_chunked_sdpa(q, k, v, attn_mask=attn_mask, dropout_p=kwargs.get("dropout_p", 0.0),
+                                is_causal=kwargs.get("is_causal", False), scale=kwargs.get("scale"))
     return torch.nn.functional.scaled_dot_product_attention(q, k, v, *args, **kwargs)
 
 

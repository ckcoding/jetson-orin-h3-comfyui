+def _h3_chunked_sdpa(q, k, v, attn_mask=None, dropout_p=0.0, is_causal=False, scale=None):
+    # Memory-bounded exact SDPA: softmax over keys is per-query-row, so chunking
+    # the query dim is mathematically identical to full attention.
+    B, H, Sq, D = q.shape
+    Sk = k.shape[-2]
+    elem = q.element_size()
+    budget = int(3e8)  # ~300MB per score chunk
+    chunk = max(64, min(Sq, budget // max(1, (B * H * Sk * elem))))
+    out = torch.empty_like(q)
+    neg = torch.finfo(q.dtype).min
+    s_scale = scale if scale is not None else (1.0 / (D ** 0.5))
+    add_mask = None
+    if attn_mask is not None and attn_mask.dtype.is_floating_point:
+        add_mask = attn_mask.to(q.dtype)
+    bool_mask = attn_mask if (attn_mask is not None and attn_mask.dtype == torch.bool) else None
+    for i in range(0, Sq, chunk):
+        j = min(i + chunk, Sq)
+        qi = q[:, :, i:j, :]
+        # fp32 attention math: bf16 softmax over long keys loses too much precision
+        s = torch.matmul(qi.float(), k.float().transpose(-1, -2)) * s_scale
+        if add_mask is not None:
+            if add_mask.dim() == 4 and add_mask.shape[-2] == Sq:
+                s = s + add_mask[:, :, i:j, :]
+            else:
+                s = s + add_mask
+        if bool_mask is not None:
+            if bool_mask.dim() == 4 and bool_mask.shape[-2] == Sq:
+                s = s.masked_fill(~bool_mask[:, :, i:j, :], neg)
+            else:
+                s = s.masked_fill(~bool_mask, neg)
+        if is_causal:
+            r = torch.arange(i, j, device=q.device)[:, None] - torch.arange(Sk, device=q.device)[None, :]
+            s = s.masked_fill(r < 0, neg)
+        w = torch.softmax(s, dim=-1)
+        if dropout_p > 0.0:
+            w = torch.nn.functional.dropout(w, p=dropout_p)
+        out[:, :, i:j, :] = torch.matmul(w, v.float()).to(q.dtype)
+    return out
+
+
 def scaled_dot_product_attention(q, k, v, *args, **kwargs):
     attn_mask = args[0] if len(args) > 0 else kwargs.get("attn_mask")
